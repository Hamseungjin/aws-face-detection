# Web UI backend config -- copy to .env for LOCAL development (never commit .env).
# On EC2 these values are written to /etc/webui.env by webui-bootstrap.sh from SSM.

# --- login (REQUIRED) -----------------------------------------------------
WEBUI_AUTH_USERNAME=admin
# PBKDF2 hash of your password -- generate with:  python auth.py 'your-password'
WEBUI_AUTH_PASSWORD_HASH='pbkdf2_sha256$200000$Y+UOTv9i/ahzyZXEZMQCcg==$w43EabbQWdrqdnjpaYbm9JDMHNSpE/rnNGkqirP8SNs='
# Random secret used to sign the session cookie -- generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
WEBUI_SESSION_SECRET='QdYzjP365oOsOLWw2SVR2nxACifK5ozqzKAyFXT9QYg40OIRJpBIZwX84CQqfpx4'

# --- session cookie flags -------------------------------------------------
# Local plain HTTP (http://localhost:8080 or http://127.0.0.1:8080):
#   WEBUI_SESSION_HTTPS_ONLY=false   # REQUIRED — Secure cookies are rejected on HTTP
# Deployed HTTPS (EC2 webui-bootstrap sets true automatically):
#   WEBUI_SESSION_HTTPS_ONLY=true
# If login returns 200 but /api/config and /api/detect-labels return 401, the
# browser is not sending the session cookie. Common causes:
#   1) WEBUI_SESSION_HTTPS_ONLY=true while using plain HTTP
#   2) Mixing hosts: login on localhost then calling 127.0.0.1 (or the reverse)
#   3) .env changed without restarting uvicorn (config is loaded at startup)
# Restart uvicorn after changing these values.
WEBUI_SESSION_HTTPS_ONLY=false
# Optional SameSite policy: lax (default) | strict | none
# "none" requires HTTPS + WEBUI_SESSION_HTTPS_ONLY=true (cross-site only).
# WEBUI_SESSION_SAME_SITE=lax

# --- AWS (non-secret names only) ------------------------------------------
# Region must match the deployed video-analyzer-stack Collection.
AWS_DEFAULT_REGION=ap-northeast-2
# Optional alias; config.py also accepts AWS_REGION.
# AWS_REGION=ap-northeast-2

# --- kiosk transaction database -------------------------------------------
# Defaults to web-ui/backend/data/kiosk.sqlite3 when omitted. For deployment,
# point this at persistent single-host storage such as /var/lib/webui/kiosk.sqlite3.
# KIOSK_DB_PATH=/var/lib/webui/kiosk.sqlite3
KIOSK_RESERVATION_SECONDS=120
KIOSK_RETRIEVAL_SECONDS=120
# Process-local minimum protection: 5 failed bearer-code lookups per kiosk session/60s.
KIOSK_RETRIEVAL_MAX_FAILURES=5
KIOSK_RETRIEVAL_RATE_WINDOW_SECONDS=60

# --- Rekognition Collection (STORE IndexFaces / RETRIEVE SearchFacesByImage)
FACE_SIMILARITY_THRESHOLD=90
# Required for POST /api/kiosk/store/complete (IndexFaces). If empty, complete
# returns 502 FACE_COLLECTION_NOT_CONFIGURED even after CompareFaces PASS.
REKOGNITION_FACE_COLLECTION_ID=kiosk-face-collection
# REKOGNITION_SEARCH_MAX_FACES=5
# LOCKER_HOLD_TTL_SECONDS=180
# Local demo without YuNet ONNX only:
# FACE_QUALITY_ALLOW_UNTRUSTED_DETECTOR=true
# KIOSK_STORE_VERIFICATION_SECONDS=120

# --- local OpenCV face quality gate (camera FRAME-A / FRAME-B) ------------
# Strict Kiosk Profile 1st calibration defaults. Not claimed standards.
# Calibrate on the real kiosk camera/lighting. See opencv_strict_quality_gate.md.
# FACE_DETECTION_SCORE_THRESHOLD=0.75  # 0-1; raise → more NO_FACE
# FACE_MIN_AREA_RATIO=0.08             # face/frame area; raise → stand closer
# FACE_CENTER_TOLERANCE=0.20           # |center-0.5|; lower → stricter centering
# FACE_MIN_BRIGHTNESS=55               # face ROI mean gray 0-255
# FACE_MAX_BRIGHTNESS=205              # face ROI mean gray 0-255; lower → stricter
# FACE_MIN_SHARPNESS=30                # Laplacian variance of face ROI
# FACE_POSE_CHECK_ENABLED=true         # YuNet 2D landmark roll/yaw heuristic
# FACE_MAX_EYE_TILT_DEGREES=20         # |eye line vs horizontal|; lower → stricter
# FACE_MAX_YAW_RATIO=0.38              # |nose-eye mid| / IOD; lower → stricter
# FACE_MIN_IMAGE_WIDTH=80
# FACE_MIN_IMAGE_HEIGHT=80
# FACE_DETECT_MAX_SIDE=320
# Optional YuNet ONNX (not committed). Official OpenCV zoo:
#   face_detection_yunet_2023mar.onnx
# FACE_DETECTOR_MODEL_PATH=/opt/webui/backend/models/face_detection_yunet_2023mar.onnx

# --- AWS credentials (LOCAL only; never commit real keys) -----------------
# Do NOT put AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in this file or in git.
# boto3 uses its default credential chain, in order:
#   1) environment variables (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY [/ AWS_SESSION_TOKEN])
#   2) shared config/credentials files (~/.aws/credentials, ~/.aws/config)
#   3) AWS_PROFILE / AWS_DEFAULT_PROFILE selecting a named profile
#   4) EC2 instance profile / ECS task role (deployed hosts)
#
# Laptop / local PC example:
#   export AWS_PROFILE=default
#   export AWS_DEFAULT_REGION=ap-northeast-2
#   aws sts get-caller-identity   # must succeed before capture/detect-labels work
#   uvicorn app:app --host 127.0.0.1 --port 8080
#
# Deployed webui EC2 uses the instance IAM role (no profile, no keys in .env).
# Required data stack: video-analyzer-stack in ap-northeast-2 (FrameStream + imageprocessor).
# If that stack is missing/deleted, /api/capture-frame and /api/detect-labels return 502
# with category "AWS resource not found" even when credentials are valid.
