# Web UI backend config -- copy to .env for LOCAL development (never commit .env).
# On EC2 these values are written to /etc/webui.env by webui-bootstrap.sh from SSM.

# --- login (REQUIRED) -----------------------------------------------------
WEBUI_AUTH_USERNAME=admin
# PBKDF2 hash of your password -- generate with:  python auth.py 'your-password'
WEBUI_AUTH_PASSWORD_HASH='pbkdf2_sha256$200000$Y+UOTv9i/ahzyZXEZMQCcg==$w43EabbQWdrqdnjpaYbm9JDMHNSpE/rnNGkqirP8SNs='
# Random secret used to sign the session cookie -- generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
WEBUI_SESSION_SECRET='QdYzjP365oOsOLWw2SVR2nxACifK5ozqzKAyFXT9QYg40OIRJpBIZwX84CQqfpx4'

# --- local dev: http://localhost is a secure context, so allow non-HTTPS cookie
WEBUI_SESSION_HTTPS_ONLY=false

# --- AWS / Kinesis --------------------------------------------------------
AWS_DEFAULT_REGION=ap-northeast-2
KINESIS_STREAM=FrameStream

# --- frame viewer (API Gateway lookup from the data stack) ----------------
DATA_STACK=video-analyzer-stack
DATA_API_STAGE=development

# Local-only: provide credentials via your AWS profile when running uvicorn, e.g.
#   AWS_PROFILE=video-analyzer uvicorn app:app --port 8080
